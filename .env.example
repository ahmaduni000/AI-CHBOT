# ============================================
#  Nebula AI Chatbot - Environment Configuration
# ============================================

# Flask secret key (generate a long random string)
SECRET_KEY=your-super-secret-random-key-change-me

# --- AI Provider (OpenAI-compatible endpoint) ---
# Replace with your actual API key. NEVER expose this in frontend code.
AI_API_KEY=your-api-key-here

# Provider mode:
#   mock    = built-in offline demo responder (no working API needed, answers immediately)
#   openai  = real OpenAI-compatible API (requires a valid AI_API_KEY + AI_BASE_URL)
AI_PROVIDER=mock

# OpenAI-compatible base URL for the provider (OpenAI official)
AI_BASE_URL=https://api.openai.com/v1

# Model name
AI_MODEL=gpt-3.5-turbo

# Generation parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT=60

# --- Database ---
DATABASE_URL=sqlite:///database/chatbot.db

# --- Uploads ---
MAX_UPLOAD_MB=10
